          <mxGeometry as="geometry" x="5020" y="2320" width="280" height="100" />
        </mxCell>
        <mxCell id="works-to-genesis" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:28px;text-align:left;white-space:nowrap;&quot;&gt;&lt;div style=&quot;margin-top:0px;&quot;&gt;Click the Genesis picture in Works.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;0–0.5 s: any expanded picture returns to its usual width; color returns&lt;br&gt;to grayscale and project names fade away.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;0.5–1 s: the heading slides upward out of view. The pictures are&lt;br&gt;covered from bottom to top, without moving the pictures themselves.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;At 1 s, request Genesis. Wait until it is ready, then start its entrance:&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;The title and description rise slightly and fade in. Lower lines start&lt;br&gt;earlier; all lines finish at 0.5 s.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;At the same time, the video is uncovered from bottom to top over 0.5&lt;br&gt;s, while the picture stays still. The GitHub link also fades in over 0.5&lt;br&gt;s.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;The poster stays visible until a video frame is ready.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;The wordmark and Menu stay in place.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;Back / Forward with the menu closed uses the same 1 s exit.&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;With reduced motion, the exit wait and page animations are skipped.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=24;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=2;shadow=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="5580" y="1590" width="680" height="650" />
        </mxCell>
