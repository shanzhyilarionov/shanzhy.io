          <mxGeometry as="geometry" x="120" y="3380" width="800" height="620" />
        </mxCell>
        <mxCell id="about-origin" value="&lt;div style=&quot;font-family:Arial;font-size:30px;line-height:40px;text-align:center;white-space:nowrap;&quot;&gt;&lt;div style=&quot;margin-top:0px;&quot;&gt;Nav menu opened&lt;/div&gt;&lt;div style=&quot;margin-top:0px;&quot;&gt;from other pages&lt;/div&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=24;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=2;shadow=0;" vertex="1" parent="1">
